# CBT Therapy Assistant 环境变量配置
# 复制此文件为 .env 并填入实际值

# OpenAI API 密钥（可选，如果使用LLM API）
# 如果不使用LLM API，可以留空
# 请将你的真实API密钥填入 .env 文件中，不要提交到版本控制
OPENAI_API_KEY=your_openai_api_key_here

# 数据库连接URL（默认使用SQLite）
# SQLite: sqlite:///./data/cbt_therapy.db
# MySQL: mysql+pymysql://user:password@localhost:3306/cbt_therapy
DATABASE_URL=sqlite:///./data/cbt_therapy.db

# 应用配置
# API服务端口
PORT=8000

# 是否启用调试模式
DEBUG=False

# Google Cloud Speech-to-Text API
# Option 1: Path to service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2: Service account JSON content (alternative to file path)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

